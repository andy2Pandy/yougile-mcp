# YouGile MCP Server Configuration
# Copy this file to .env and fill in your values

# YouGile API Base URL (usually https://yougile.com)
YOUGILE_BASE_URL=https://yougile.com

# MCP transport: stdio for local clients, streamable-http for ChatGPT Work
MCP_TRANSPORT=stdio
PORT=8000

# Optional secret URL segment for a private remote pilot.
# The remote endpoint becomes /<MCP_URL_TOKEN>/mcp.
MCP_URL_TOKEN=replace-with-a-long-random-value

# Development Settings (optional)
YOUGILE_DEBUG=false
YOUGILE_TIMEOUT=30
YOUGILE_MAX_RETRIES=3

# Recommended authentication: create an API key in YouGile and store it as a secret.
YOUGILE_COMPANY_ID=00000000-0000-0000-0000-000000000000
YOUGILE_API_KEY=your-yougile-api-key
YOUGILE_READ_ONLY=true

# Optional only for local stdio mode if you want automatic API-key creation.
# Never send these values through a ChatGPT conversation.
# YOUGILE_EMAIL=your-email@yougile.com
# YOUGILE_PASSWORD=your-password
